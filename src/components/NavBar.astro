---
const defaultItems = [
  { href: "/#servicios", label: "Servicios" },
  { href: "/#proyectos", label: "Proyectos" },
  { href: "/#metodo", label: "Cómo trabajo" },
  { href: "/#calidad", label: "Calidad" },
  { href: "/#faq", label: "FAQ" },
  { href: "/#contacto", label: "Contacto" },
];

const compactItems = [
  { href: "/#servicios", label: "Servicios" },
  { href: "/#proyectos", label: "Proyectos" },
  { href: "/#metodo", label: "Proceso" },
  { href: "/#cotizacion", label: "Cotización" },
  { href: "/sobre-b-software/", label: "Sobre" },
];

const { variant = "default" } = Astro.props;
const compact = variant === "compact";
const items = compact ? compactItems : defaultItems;
const cta = compact
  ? { href: "/#contacto", label: "Solicitar propuesta", external: false }
  : { href: "https://wa.me/5493434064408", label: "WhatsApp", external: true };
---

<header class="site-header">
  <div class="nav-shell">
    <a href="/" class="brand">
      <span class="brand-mark">
        <img src="/brand/logo-b-96.webp" alt="" width="96" height="96" />
      </span>
      <span>
        <strong>B-Software</strong>
        <small>Soluciones digitales</small>
      </span>
    </a>

    <nav class="nav-links" aria-label="Principal">
      {items.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>

    <div class="language-switcher" role="group" aria-label="Idioma">
      <button type="button" class="language-option" data-language-option="es" aria-pressed="true" aria-label="Ver sitio en español">ES</button>
      <button type="button" class="language-option" data-language-option="en" aria-pressed="false" aria-label="View site in English">EN</button>
    </div>

    <a class="nav-cta" href={cta.href} target={cta.external ? "_blank" : undefined} rel={cta.external ? "noreferrer" : undefined}>{cta.label}</a>

    <details class="mobile-nav">
      <summary aria-label="Abrir menú de navegación">Menú</summary>
      <nav aria-label="Principal móvil">
        {items.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
        <a href={cta.href} target={cta.external ? "_blank" : undefined} rel={cta.external ? "noreferrer" : undefined}>{cta.label}</a>
      </nav>
    </details>
  </div>
</header>
